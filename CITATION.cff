        given-names: Daniel
      - family-names: Panickssery
        given-names: Nina
      - family-names: Gurnee
        given-names: Wes
      - family-names: Nanda
        given-names: Neel
    year: 2024
    url: "https://arxiv.org/abs/2406.11717"
    notes: "Origin of the directional-ablation operator implemented here."
